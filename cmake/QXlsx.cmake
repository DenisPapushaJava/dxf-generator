# Pinned source is vendored; ordinary configure never accesses the network.
set(DXFGEN_QT_PRIVATE_HEADERS "" CACHE PATH "Optional matching Qt private header root (QtCore/QtGui)")
if(DXFGEN_QT_PRIVATE_HEADERS)
    # Allows a developer to unpack qt6-base-private-dev locally without installing it.
    foreach(module Core Gui)
        set_property(TARGET Qt6::${module}Private PROPERTY INTERFACE_INCLUDE_DIRECTORIES
            "${DXFGEN_QT_PRIVATE_HEADERS}/Qt${module}/${Qt6Core_VERSION};${DXFGEN_QT_PRIVATE_HEADERS}/Qt${module}/${Qt6Core_VERSION}/Qt${module}")
    endforeach()
endif()

if(TARGET Qt6::GuiPrivate)
    get_target_property(qt_private_includes Qt6::GuiPrivate INTERFACE_INCLUDE_DIRECTORIES)
    foreach(path IN LISTS qt_private_includes)
        if(NOT EXISTS "${path}")
            message(FATAL_ERROR "Matching Qt private headers are required for XLSX. Install qt6-base-private-dev or set DXFGEN_QT_PRIVATE_HEADERS to locally unpacked Qt headers.")
        endif()
    endforeach()
endif()

function(dxfgen_add_qxlsx)
    set(BUILD_SHARED_LIBS OFF)
    set(QXLSX_HEADERPATH "${PROJECT_SOURCE_DIR}/third_party/qxlsx/header")
    set(QXLSX_SOURCEPATH "${PROJECT_SOURCE_DIR}/third_party/qxlsx/source")
    add_subdirectory("${PROJECT_SOURCE_DIR}/third_party/qxlsx" "${PROJECT_BINARY_DIR}/qxlsx" EXCLUDE_FROM_ALL)
endfunction()
dxfgen_add_qxlsx()
if(MSVC)
    target_compile_options(QXlsx PRIVATE /utf-8)
endif()
if(DXFGEN_OPTIMIZE_SIZE)
    if(MSVC)
        target_compile_options(QXlsx PRIVATE $<$<CONFIG:Release>:/O1> /Gy /Gw)
    else()
        target_compile_options(QXlsx PRIVATE $<$<CONFIG:Release>:-Os> -ffunction-sections -fdata-sections)
    endif()
endif()
if(DXFGEN_ENABLE_IPO)
    set_property(TARGET QXlsx PROPERTY INTERPROCEDURAL_OPTIMIZATION_RELEASE TRUE)
endif()
