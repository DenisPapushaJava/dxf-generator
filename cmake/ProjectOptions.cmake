function(dxfgen_project_options target)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /permissive- /utf-8)
        if(DXFGEN_OPTIMIZE_SIZE)
            target_compile_options(${target} PRIVATE $<$<CONFIG:Release>:/O1> /Gy /Gw)
            target_link_options(${target} PRIVATE $<$<CONFIG:Release>:/OPT:REF> $<$<CONFIG:Release>:/OPT:ICF>)
        endif()
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wshadow)
        if(DXFGEN_OPTIMIZE_SIZE)
            target_compile_options(${target} PRIVATE $<$<CONFIG:Release>:-Os> -ffunction-sections -fdata-sections)
            if(NOT APPLE)
                target_link_options(${target} PRIVATE $<$<CONFIG:Release>:-Wl,--gc-sections>)
            endif()
        endif()
        if(DXFGEN_SANITIZERS)
            if(MINGW)
                message(FATAL_ERROR "Use the Linux sanitizer preset for sanitizer checks")
            endif()
            target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
            target_link_options(${target} PRIVATE -fsanitize=address,undefined)
        endif()
    endif()
    if(DXFGEN_ENABLE_IPO)
        set_property(TARGET ${target} PROPERTY INTERPROCEDURAL_OPTIMIZATION_RELEASE TRUE)
    endif()
endfunction()
