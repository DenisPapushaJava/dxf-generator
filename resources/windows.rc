#include <windows.h>
#include "version_info.h"

1 RT_MANIFEST "windows.manifest"
101 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DXFGEN_FILE_VERSION
 PRODUCTVERSION DXFGEN_FILE_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "DenisPapushaJava"
            VALUE "FileDescription", "DXF Generator"
            VALUE "FileVersion", DXFGEN_FILE_VERSION_STRING
            VALUE "InternalName", "dxf-generator"
            VALUE "OriginalFilename", "dxf-generator.exe"
            VALUE "ProductName", "DXF Generator"
            VALUE "ProductVersion", DXFGEN_FILE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
