{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DXF Generator (Linux Debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/dev-linux/dxf-generator",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable GDB pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "DXF: build (Debug)"
    }
  ]
}
